{
  "name": "@lorenzoalberto-dev/datajud-sdk",
  "version": "0.1.0",
  "description": "SDK TypeScript para a API Pública do DataJud/CNJ",
  "author": "Lorenzo Alberto",
  "license": "MIT",
  "keywords": [
    "datajud",
    "cnj",
    "sdk",
    "typescript",
    "judiciario"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lorenzoalberto/datajud-sdk.git"
  },
  "homepage": "https://github.com/lorenzoalberto/datajud-sdk#readme",
  "bugs": {
    "url": "https://github.com/lorenzoalberto/datajud-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run test && npm run build",
    "smoke:package": "node scripts/smoke-package.mjs",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
